[mysqld_safe]
socket = /run/mysqld/mysqld.sock
nice = 0

[mysqld]
user = appbox
pid-file = /home/appbox/mysql/run/mysqld.pid
socket = /run/mysqld/mysqld.sock
port = 3306
basedir = /usr
datadir = /home/appbox/mysql/data
tmpdir = /tmp
lc-messages-dir = /usr/share/mysql
skip-external-locking
bind-address = 127.0.0.1
# MySQL 8.4 disables this plugin by default. Older Appbox WordPress databases
# can have accounts that still use it, and the root account must keep working.
mysql_native_password = ON

key_buffer_size = 16M
max_allowed_packet = 64M
thread_stack = 192K
thread_cache_size = 8
myisam-recover-options = BACKUP

log_error = /home/appbox/logs/mysql/error.log
binlog_expire_logs_seconds = 864000
max_binlog_size = 100M

[mysqldump]
quick
quote-names
max_allowed_packet = 64M

[mysql]
no-auto-rehash

[isamchk]
key_buffer = 16M
